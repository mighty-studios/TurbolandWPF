<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TEXT BOX
         A field is exactly one cell row tall: a white/cyan bar with the
         glyphs filling it edge to edge. That leaves no room for chrome
         inside the box, so the outline is a ring drawn just outside it
         and the field carries none at rest.

         The ring is outside the measure, so focus does not grow the
         control or reflow whatever sits beside it. Standard editing
         behavior is preserved; only the chrome changes.
         ============================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.FieldBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
        <Setter Property="Padding" Value="{DynamicResource Turboland.Size.FieldPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="face" Background="{TemplateBinding Background}"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="focus"
                                Margin="{DynamicResource Turboland.Size.FocusRingOffset}"
                                BorderBrush="{DynamicResource Turboland.Brush.ControlSelected}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="BorderThickness" Value="{DynamicResource Turboland.Size.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            <!-- A disabled field takes the surface color, so without an
                                 outline it would stop looking like a field at all. -->
                            <Setter TargetName="focus" Property="BorderThickness" Value="{DynamicResource Turboland.Size.FocusBorder}"/>
                            <Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
