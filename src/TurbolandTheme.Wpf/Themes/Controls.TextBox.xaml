<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TEXT BOX
         A field is exactly one cell row tall: a white/cyan bar with the
         glyphs filling it edge to edge. That leaves no room for chrome
         inside the box, so the outline is a ring drawn just outside it.

         The ring is always present: a resting frame in the control's
         own BorderBrush, recolored when the field takes focus. Because
         it lives outside the measure it neither grows the control on
         focus nor pushes the glyphs off their row. Standard editing
         behavior is preserved; only the chrome changes.
         ============================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.FieldBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
        <Setter Property="Padding" Value="{DynamicResource Turboland.Size.FieldPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="face" Background="{TemplateBinding Background}"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="outline"
                                Margin="{DynamicResource Turboland.Size.FocusRingOffset}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource Turboland.Size.Border}"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            <!-- A disabled field takes the surface color, so the frame
                                 dims with it rather than disappearing. -->
                            <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
