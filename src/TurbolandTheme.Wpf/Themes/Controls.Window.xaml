<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         WINDOW
         Establishes the blue IDE desktop and the crisp text-rendering
         settings for the whole visual tree.

         IMPORTANT: WPF matches implicit styles on an element's *exact*
         runtime type, so the implicit `TargetType="Window"` style below
         only reaches a plain `Window`. A derived shell (`MainWindow :
         Window`) never picks it up. TurbolandTheme.ApplyTo therefore
         assigns Turboland.Style.WindowShell explicitly, which is why
         calling it per window is required, not optional.

         Dialogs are light gray, not blue: pass isDialog:true to
         ApplyTo, or drop a Border with Turboland.Style.DialogSurface
         onto the desktop for an in-window dialog.
         ============================================================ -->

    <Style x:Key="Turboland.Style.WindowBase" TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Application shell: the blue desktop. -->
    <Style x:Key="Turboland.Style.WindowShell" TargetType="Window"
           BasedOn="{StaticResource Turboland.Style.WindowBase}">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.DesktopBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DesktopForeground}"/>
    </Style>

    <!-- Dialog shell: light gray face, black text. -->
    <Style x:Key="Turboland.Style.DialogWindow" TargetType="Window"
           BasedOn="{StaticResource Turboland.Style.WindowBase}">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
    </Style>

    <!-- Reaches plain (non-derived) Window instances only. -->
    <Style TargetType="Window" BasedOn="{StaticResource Turboland.Style.WindowShell}"/>

    <!-- In-window dialog surface: gray face, black outline, hard shadow.
         For a full dialog use the TurbolandDialog control; these two styles are for
         plain Borders that want the same chrome (the Gallery's catalogue panel).
         Apply DialogShadow to a Border declared *first* in the same Grid cell: its
         margin is the shadow offset, so it needs no positioning from the caller and,
         because the negative half cancels the positive, costs no layout space. -->
    <Style x:Key="Turboland.Style.DialogSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Turboland.Size.DialogBorder}"/>
        <Setter Property="Padding" Value="{DynamicResource Turboland.Size.GroupBoxPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
    </Style>

    <Style x:Key="Turboland.Style.DialogShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.Shadow}"/>
        <Setter Property="Margin" Value="{DynamicResource Turboland.Size.DialogShadowOffset}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
