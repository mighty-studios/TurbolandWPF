<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls">

    <!-- ============================================================
         TURBOLAND DIALOG
         An in-client dialog: light-gray face, white double-line frame,
         the title centred ON the top frame line with a close box to
         its left, and a hard shadow two cells right and one row down.

         The whole top frame row contains only three colors: gray
         face, white frame AND white title text, and a light-green
         square inside the close box.

         Unlike the window frame there is NO zoom box - the top-right
         corner turns straight into the frame - and no inactive
         line-weight change: a dialog is drawn with double lines
         whether or not it is frontmost.

         Glyphs are numeric character references so the file's encoding
         can never silently corrupt the frame.

         Dragging, keyboard move (Ctrl+F5), shading and soft modality
         live in TurbolandDialog.cs / TurbolandDialogHost.cs, not here.
         ============================================================ -->

    <Style x:Key="Turboland.Style.DialogFrameGlyph" TargetType="ctl:GlyphFill">
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FrameActive}"/>
    </Style>

    <Style x:Key="Turboland.Style.DialogFrameText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FrameActive}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- Deliberately a near-copy of the window's close box rather than a shared
         BasedOn: a StaticResource cannot reach a key defined in a sibling merged
         dictionary, and the two differ anyway - this one is an ordinary templated
         part driven by the control, with no WindowChrome involvement, and it
         inverts to black-on-white because its face is gray rather than blue. -->
    <Style x:Key="Turboland.Style.DialogCloseBox" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FrameActive}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="face" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="bracketLeft" Text="["
                                       Foreground="{TemplateBinding Foreground}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                            <TextBlock x:Name="mark" Text="&#x25A0;"
                                       Foreground="{DynamicResource Turboland.Brush.FrameCloseMark}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                            <TextBlock x:Name="bracketRight" Text="]"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background"
                                    Value="{DynamicResource Turboland.Brush.FrameActive}"/>
                            <Setter TargetName="bracketLeft" Property="Foreground"
                                    Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
                            <Setter TargetName="mark" Property="Foreground"
                                    Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
                            <Setter TargetName="bracketRight" Property="Foreground"
                                    Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Turboland.Style.TurbolandDialog" TargetType="ctl:TurbolandDialog">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>

        <!-- Fed to DialogGeometry for the drag clamp and the keyboard move step, so both
             follow the theme scale instead of assuming 1x. -->
        <Setter Property="TitleBarHeight" Value="{DynamicResource Turboland.Metric.TitleBarHeight}"/>
        <Setter Property="MinVisibleWidth" Value="{DynamicResource Turboland.Metric.DialogMinVisible}"/>
        <Setter Property="CellWidth" Value="{DynamicResource Turboland.Metric.CellWidth}"/>
        <Setter Property="CellHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:TurbolandDialog">
                    <!-- One cell holding shadow and face. The shadow is declared first so
                         it sits behind, and carries a margin whose right/bottom are
                         negative, which pushes it outside the dialog's bounds without
                         inflating them. It therefore contributes nothing to the measured
                         size: an empty Border's desired size is zero, and 16 + -16 = 0. -->
                    <Grid>
                        <Border x:Name="shadow"
                                Background="{DynamicResource Turboland.Brush.Shadow}"
                                Margin="{DynamicResource Turboland.Size.DialogShadowOffset}"
                                SnapsToDevicePixels="True"/>

                        <Border x:Name="face"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="contentRow" Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top frame line: corner, close box, rule, title, rule,
                                     corner. The two star columns keep the title centred
                                     however wide the dialog gets. -->
                                <Grid x:Name="PART_TitleBar" Grid.Row="0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ctl:GlyphFill Grid.Column="0" Glyph="&#x2554;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <Button x:Name="PART_CloseBox" Grid.Column="1"
                                            Style="{StaticResource Turboland.Style.DialogCloseBox}"/>

                                    <ctl:GlyphFill Grid.Column="2" Glyph="&#x2550;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <TextBlock x:Name="title" Grid.Column="3"
                                               Text="{TemplateBinding Title}"
                                               Padding="{DynamicResource Turboland.Size.CellPadding}"
                                               Style="{StaticResource Turboland.Style.DialogFrameText}"/>

                                    <ctl:GlyphFill Grid.Column="4" Glyph="&#x2550;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <ctl:GlyphFill Grid.Column="5" Glyph="&#x2557;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>
                                </Grid>

                                <!-- Content, flanked by the vertical frame runs. -->
                                <Grid x:Name="body" Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ctl:GlyphFill Grid.Column="0" Glyph="&#x2551;" Orientation="Vertical"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <ContentPresenter Grid.Column="1"
                                                      Margin="{DynamicResource Turboland.Size.GroupBoxPadding}"/>

                                    <ctl:GlyphFill Grid.Column="2" Glyph="&#x2551;" Orientation="Vertical"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>
                                </Grid>

                                <!-- Bottom frame line. Kept visible when shaded, so a
                                     collapsed dialog still reads as a closed object
                                     rather than a stray rule. -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ctl:GlyphFill Grid.Column="0" Glyph="&#x255A;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <ctl:GlyphFill Grid.Column="1" Glyph="&#x2550;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>

                                    <ctl:GlyphFill Grid.Column="2" Glyph="&#x255D;"
                                                   Style="{StaticResource Turboland.Style.DialogFrameGlyph}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Shaded: collapse the body, leaving the two frame lines. -->
                        <Trigger Property="IsShaded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Keyboard move mode (Ctrl+F5) has to be visible, or the arrow
                             keys silently change meaning; the title inverts to signal it. -->
                        <Trigger Property="IsMoveMode" Value="True">
                            <Setter TargetName="title" Property="Background"
                                    Value="{DynamicResource Turboland.Brush.FrameActive}"/>
                            <Setter TargetName="title" Property="Foreground"
                                    Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
