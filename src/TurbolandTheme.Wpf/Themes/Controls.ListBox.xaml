<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         LIST BOX
         Cyan field, black text, no frame - the field steps straight
         from the surrounding surface to the list content with no
         border pixel. Rows are one cell each and selection is a
         full-width bar.

         The frame is a ring outside the layout box, drawn only when the
         list has focus or is disabled. That is what lets a list sized in
         whole rows actually show whole rows: a 1px border would take two
         pixels out of the interior and clip the last one.
         ============================================================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.FieldBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="face" Background="{TemplateBinding Background}"/>
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                        <Border x:Name="focus"
                                Margin="{DynamicResource Turboland.Size.FocusRingOffset}"
                                BorderBrush="{DynamicResource Turboland.Brush.ControlSelected}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="focus" Property="BorderThickness" Value="{DynamicResource Turboland.Size.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            <Setter TargetName="focus" Property="BorderThickness" Value="{DynamicResource Turboland.Size.FocusBorder}"/>
                            <Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Turboland.Size.ItemPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border" Background="Transparent"/>
                        <ContentPresenter VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        <!-- Focus ring inside the row, not outside: a row at the top or
                             bottom of the list would have an outside ring clipped by the
                             scroll viewer. Zero thickness until asked for, so it never
                             changes the row height - which would reflow the whole list
                             as the selection moved. -->
                        <Border x:Name="focus"
                                BorderBrush="{DynamicResource Turboland.Brush.FocusOutline}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="focus" Property="BorderThickness" Value="{DynamicResource Turboland.Size.FocusBorder}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
