<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TurbolandTheme.Wpf.Controls">

    <!-- ============================================================
         CHECK BOX
         A check box is literal text: "[ ] Label", "[X] Label" when
         checked. Four character cells '[', ' ', ']', ' ' then the
         label, all on one FieldBackground (cyan) row spanning the
         whole control, black text, yellow accelerator. It is NOT a
         drawn box with a vector tick.

         Drawing it as text also makes it scale: the glyph inherits
         FontSize from the control, so 2x doubles it automatically.
         A Path/Geometry cannot scale from a resource.
         ============================================================ -->
    <Style TargetType="CheckBox">
        <Setter Property="c:AcceleratorText.AcceleratorBrush" Value="{DynamicResource Turboland.Brush.FieldAccelerator}"/>
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.FieldBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            Padding="{DynamicResource Turboland.Size.CellPadding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <!-- Foreground is deliberately not set here: it
                                 inherits from the control so a single trigger
                                 recolors glyph and label together. -->
                            <TextBlock x:Name="glyph"
                                       Text="[ ] "
                                       VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="label"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              ContentTemplateSelector="{DynamicResource Turboland.Selector.Accelerator}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="glyph" Property="Text" Value="[X] "/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="glyph" Property="Text" Value="[-] "/>
                        </Trigger>
                        <!-- The focused row is drawn in white on the
                             same cyan field, not with a highlight bar. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldFocusedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldFocusedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            <!-- Never advertise a hot key that cannot be pressed. -->
                            <Setter Property="c:AcceleratorText.AcceleratorBrush" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
