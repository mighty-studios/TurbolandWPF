<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TurbolandTheme.Wpf.Controls">

    <!-- ============================================================
         TAB CONTROL
         Page: gray face, black 1px frame. Selected tab: merges into
         the page (black outline, open bottom). Unselected: gray,
         dimmed text. Hover = blue with white text.
         ============================================================ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <!-- Zero, not CellPadding: the page paints WindowBackground, so any horizontal
             padding shows as gray bars beside the content. Apps that want an inset set
             Padding themselves. -->
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- ZIndex, not declaration order: the header already carries a
                             -1 bottom margin so the selected tab overlaps the page's top
                             border and merges into it. Drawn first, the page would paint
                             that border straight back over the tab and the two would read
                             as separate boxes with a rule between them. -->
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Row="0"
                                  Panel.ZIndex="1"
                                  IsItemsHost="True"
                                  Margin="{DynamicResource Turboland.Size.TabSelectedOffset}"
                                  Background="Transparent"
                                  KeyboardNavigation.TabIndex="1"/>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource Turboland.Size.Border}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="c:AcceleratorText.AcceleratorBrush" Value="{DynamicResource Turboland.Brush.FieldAccelerator}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="border"
                            Margin="{DynamicResource Turboland.Size.TabUnselectedOffset}"
                            Background="{DynamicResource Turboland.Brush.ControlFace}"
                            BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
                            BorderThickness="{DynamicResource Turboland.Size.Border}"
                            Padding="{DynamicResource Turboland.Size.TabPadding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="content"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          ContentTemplateSelector="{DynamicResource Turboland.Selector.Accelerator}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Turboland.Brush.ControlSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.ControlSelectedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Margin" Value="0,0,0,0"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="{DynamicResource Turboland.Size.TabSelectedBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.WindowForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            <!-- Never advertise a hot key that cannot be pressed. -->
                            <Setter Property="c:AcceleratorText.AcceleratorBrush" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
