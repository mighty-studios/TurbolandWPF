<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TREE VIEW
         White field, black frame. [+] / [-] one-cell expander boxes;
         selection and hover = black text on blue.
         ============================================================ -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Turboland.Brush.FieldBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource Turboland.Size.Border}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Turboland.Brush.ControlSelected}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="{DynamicResource Turboland.Size.DialogBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Turboland.Brush.WindowBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource Turboland.Grid.TreeIndent}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander"
                                      Grid.Row="0" Grid.Column="0"
                                      Width="{DynamicResource Turboland.Metric.CellHeight}"
                                      Height="{DynamicResource Turboland.Metric.CellHeight}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <!-- Text, not Path geometry, so the marker
                                             scales with FontSize. -->
                                        <TextBlock x:Name="marker"
                                                   Text="+"
                                                   Foreground="{DynamicResource Turboland.Brush.FieldForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="marker" Property="Text" Value="&#x2500;"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="marker" Property="Foreground" Value="{DynamicResource Turboland.Brush.ControlSelectedForeground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="b"
                                Grid.Row="0" Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{DynamicResource Turboland.Size.TreeItemPadding}">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <!-- keep the indent so leaves align with parent rows -->
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Turboland.Brush.FieldSelectionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.FieldSelectionForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
