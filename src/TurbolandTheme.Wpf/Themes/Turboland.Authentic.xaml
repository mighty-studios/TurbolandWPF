<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TURBOLAND THEME - AUTHENTIC MODE (aggregator)
         Maximum visual accuracy: original VGA palette, 9x16 cell
         grid at integer scale, tight spacing.
         Merge: tokens first, then every control dictionary.
         ============================================================ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.Colors.xaml"/>
        <ResourceDictionary Source="Tokens.Metrics.xaml"/>
        <ResourceDictionary Source="Tokens.Typography.xaml"/>

        <ResourceDictionary Source="Controls.Window.xaml"/>
        <ResourceDictionary Source="Controls.TurbolandWindow.xaml"/>
        <ResourceDictionary Source="Controls.TurbolandDialog.xaml"/>
        <ResourceDictionary Source="Controls.Accelerator.xaml"/>
        <ResourceDictionary Source="Controls.Button.xaml"/>
        <ResourceDictionary Source="Controls.CheckBox.xaml"/>
        <ResourceDictionary Source="Controls.RadioButton.xaml"/>
        <ResourceDictionary Source="Controls.TextBox.xaml"/>
        <ResourceDictionary Source="Controls.PasswordBox.xaml"/>
        <ResourceDictionary Source="Controls.Menu.xaml"/>
        <ResourceDictionary Source="Controls.ListBox.xaml"/>
        <ResourceDictionary Source="Controls.ComboBox.xaml"/>
        <ResourceDictionary Source="Controls.TreeView.xaml"/>
        <ResourceDictionary Source="Controls.ScrollBar.xaml"/>
        <ResourceDictionary Source="Controls.StatusBar.xaml"/>
        <ResourceDictionary Source="Controls.TabControl.xaml"/>
        <ResourceDictionary Source="Controls.GroupBox.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
